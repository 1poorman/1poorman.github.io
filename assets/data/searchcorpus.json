---
layout: null
---
{%- assign published_posts = site.posts | where_exp: 'post', 'post.listed != false' -%}
[
  {%- for post in published_posts %}
  {
    "title": {{ post.title | strip_html | jsonify }},
    "desc": {{ post.summary | default: post.excerpt | strip_html | strip | jsonify }},
    "category": {{ post.category | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "kind": {{ post.kind | jsonify }},
    "topics": {{ post.topics | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: '%Y-%m-%d' | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
]
